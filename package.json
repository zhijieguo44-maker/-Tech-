{
  "name": "todo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "esbuild src/main.tsx --bundle --minify --outfile=dist/chat.js",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.ts",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "predev": "npm run build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "openai": "^7.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
